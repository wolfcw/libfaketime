FROM rust:1.99-slim-bookworm

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential make perl coreutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/tokio-issue-545
COPY test/tokio_issue_545/Cargo.toml test/tokio_issue_545/Cargo.lock ./
RUN mkdir src && printf 'fn main() {}\n' > src/main.rs && cargo build --locked --release
COPY test/tokio_issue_545/src/main.rs src/main.rs
# Docker COPY can preserve a timestamp that makes Cargo retain the placeholder
# binary from the dependency-cache layer. Touch the real source explicitly.
RUN touch src/main.rs && cargo build --locked --release

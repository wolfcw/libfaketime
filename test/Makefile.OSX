CC ?= clang

CFLAGS += -std=gnu99 -Wall -DFAKE_STAT $(FAKETIME_COMPILE_CFLAGS)

SRC = timetest.c
OBJ = ${SRC:.c=.o}

all: timetest set_mtime test

.c.o:
	${CC} -c ${CFLAGS} $<

timetest: ${OBJ}
	${CC} -o $@ ${OBJ} ${LDFLAGS}

set_mtime: set_mtime.c
	${CC} -o $@ ${CFLAGS} $<

test: timetest functest
	@echo
	@./test_OSX.sh

# run functional tests
functest:
	./testframe.sh functests

clean:
	@rm -f ${OBJ} timetest set_mtime

distclean: clean
	@echo

.PHONY: all test clean distclean
